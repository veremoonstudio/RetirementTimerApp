# R8 / Proguard rules for Retirement Timer App

# Keep Kotlinx Serialization models
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod
-keepclassmembers class * {
    @kotlinx.serialization.Serializable <fields>;
    @kotlinx.serialization.Serializable *;
}
-keepclassmembers class *$$serializer {
    *** INSTANCE;
}

# Keep DataStore & SettingsData models
-keep class com.veremoonstudio.retirementtimer.SettingsData { *; }
-keep class com.veremoonstudio.retirementtimer.SavedHoliday { *; }

# Google Play Billing & AdMob
-keep class com.android.billingclient.api.** { *; }
-keep class com.google.android.gms.ads.** { *; }
